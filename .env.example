# Copy to .env and fill in your values.
# Never commit .env — it's in .gitignore.

# Your Unison Memory API key (usk_live_...).
# Provision one by running: npx @unisonlabs/install-mcp
UNISON_TOKEN=

# Unison brain API base URL.
# Leave unset to use the default: https://api.unisonlabs.ai
# Set to http://localhost:4001 for a local self-hosted brain.
UNISON_API_URL=
