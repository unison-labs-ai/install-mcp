{
  "name": "@unisonlabs/install-mcp",
  "version": "1.0.0",
  "description": "One-command CLI to install the Unison Memory MCP into any client (Claude Code, Cursor, Codex, OpenCode, Windsurf, ChatGPT) — auth included.",
  "bin": {
    "install-unison-mcp": "./bin/run"
  },
  "directories": {
    "lib": "src",
    "bin": "bin"
  },
  "files": [
    "dist",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unison-labs-ai/install-mcp.git"
  },
  "scripts": {
    "build": "tsup-node",
    "build:watch": "tsup-node --watch",
    "clean": "rimraf dist",
    "compile": "tsc",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "typescript",
    "cli",
    "mcp",
    "unison",
    "memory",
    "ai"
  ],
  "author": "Unison Labs AI",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@tsconfig/node20": "^20.1.6",
    "@types/bun": "^1.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/yargs": "^17.0.33",
    "rimraf": "^5.0.10",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "consola": "^3.4.2",
    "dotenv": "^16.6.1",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "yargs": "^17.7.2"
  },
  "packageManager": "bun@1.3.4",
  "overrides": {
    "tmp": "^0.2.4"
  }
}
